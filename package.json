{
  "name": "fast-blocked-at",
  "version": "0.0.12",
  "description": "Detect event loop blockages and get a stack trace; fast enough for production.",
  "keywords": [
    "block",
    "event",
    "loop",
    "performance"
  ],
  "homepage": "https://github.com/sderrow/fast-blocked-at",
  "license": "MPL-2.0",
  "author": "Keyhan Vakil <kvakil@npm.kvakil.me>",
  "repository": {
    "type": "git",
    "url": "git://github.com/sderrow/fast-blocked-at"
  },
  "files": [
    "LICENSE",
    "binding.gyp",
    "index.d.ts",
    "index.js",
    "native.cc",
    "package.json",
    "yarn.lock",
    "README.md",
    "prebuilds"
  ],
  "main": "index.js",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "install": "node-gyp-build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "tap --no-check-coverage"
  },
  "dependencies": {
    "node-gyp": "^11.0.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prebuildify": "^6.0.1",
    "tap": "^16.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "gypfile": true,
  "readme": "README.md"
}
